# Basic arithmetic
x: Int = 5
y: Int = 3
result: Int = x + y

# Simple function
double: Int -> Int = fn (n: Int) -> n * 2
doubled: Int = double 10

# Factorial
factorial: Int -> Int = fn (n: Int) ->
  if n <= 1
    then 1
    else n * factorial(n - 1)

fact5: Int = factorial 5

# List operations
nums: [Int] = [1, 2, 3, 4, 5]
squares: [Int] = [x * x for x in nums]

# Pattern matching
check: String = 
  match result:
    | 8 -> "eight"
    | 9 -> "nine"  
    | n -> "other"

# Piping
process: Int = 10 |> double

# Record
point: {x: Int, y: Int} = {x: 10, y: 20}
moved: {x: Int, y: Int} = point edit {x: 15}
