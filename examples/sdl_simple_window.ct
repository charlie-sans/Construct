// ============================================================================
// Simple SDL Window Example for Construct
// ============================================================================

// SDL Constants
let SDL_INIT_VIDEO = 0x00000020
let SDL_QUIT = 12

// External SDL Functions
extern fn SDL_Init(flags: UInt) -> Int
extern fn SDL_Quit()
extern fn SDL_CreateWindow(title: CStr, x: Int, y: Int, w: Int, h: Int, flags: Int) -> IntPtr
extern fn SDL_DestroyWindow(window: IntPtr)
extern fn SDL_Delay(ms: UInt)

// ============================================================================
// Main Program
// ============================================================================

dump("Initializing SDL...")
SDL_Init(SDL_INIT_VIDEO)

dump("Creating window...")
let window = SDL_CreateWindow("My First SDL Window", 100, 100, 800, 600, 0)

if window != 0 then
    dump("Window created successfully!")
    dump("Keeping window open for 3 seconds...")
    
    // Keep window open for 3 seconds (3000 milliseconds)
    SDL_Delay(3000)
    
    dump("Closing window...")
    SDL_DestroyWindow(window)
end

dump("Shutting down SDL...")
SDL_Quit()
dump("Done!")
