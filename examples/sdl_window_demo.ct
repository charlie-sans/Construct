// ============================================================================
// SDL Window Demo for Construct Language
// ============================================================================

// SDL Constants
let SDL_INIT_VIDEO = 0x00000020
let SDL_QUIT = 12
let SDL_KEYDOWN = 2
let SDL_KEYUP = 3

// ============================================================================
// SDL External Functions
// ============================================================================

extern fn SDL_Init(flags: UInt) -> Int
extern fn SDL_Quit()
extern fn SDL_CreateWindow(title: CStr, x: Int, y: Int, w: Int, h: Int, flags: Int) -> IntPtr
extern fn SDL_DestroyWindow(window: IntPtr)
extern fn SDL_PollEvent(event: IntPtr) -> Int
extern fn SDL_SetWindowSize(window: IntPtr, w: Int, h: Int)
extern fn SDL_GetWindowSize(window: IntPtr, w_ptr: IntPtr, h_ptr: IntPtr)
extern fn SDL_Delay(ms: UInt)

// Helper function to get event type from opaque SDL_Event pointer
extern fn get_event_type(event: IntPtr) -> Int

// ============================================================================
// Main Program
// ============================================================================

// Initialize SDL video subsystem
SDL_Init(SDL_INIT_VIDEO)

// Create window: title, x, y, width, height, flags
let window = SDL_CreateWindow("Construct SDL Window Demo", 100, 100, 800, 600, 0)

// Check if window was created successfully
if window != 0 then
    dump("Window created successfully!")
    
    // Allocate space for SDL_Event (opaque pointer)
    let event_ptr = 0
    
    // Main event loop
    let mut running = true
    while running do
        // Poll for events
        let has_event = SDL_PollEvent(event_ptr)
        
        if has_event != 0 then
            // Get event type using helper function
            let event_type = get_event_type(event_ptr)
            
            // Check if it's a quit event
            if event_type == SDL_QUIT then
                dump("Quit event detected!")
                running = false
            else
                dump("Event type: ")
                dump(event_type)
            end
        end
        
        // Small delay to prevent busy-waiting
        SDL_Delay(10)
    end
    
    // Cleanup
    SDL_DestroyWindow(window)
    SDL_Quit()
    dump("Window closed and SDL cleaned up")
else
    dump("Failed to create window")
end
