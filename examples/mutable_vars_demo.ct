// Mutable Variables Demo
// Demonstrates the mut keyword for mutable variables

// Immutable variable (cannot be reassigned)
let x = 10
dump(x)

// Mutable variable (can be reassigned)
let mut counter = 0
dump(counter)

counter = counter + 1
dump(counter)

counter = counter + 1
dump(counter)

counter = counter + 1
dump(counter)

// Mutable with explicit type
let mut value: Int = 100
dump(value)

value = value + 50
dump(value)

// Mutable float
let mut pi: Double = 3.14
dump(pi)

pi = pi + 0.00159
dump(pi)

// Using mutable in a loop (conceptual)
let mut sum = 0
dump(sum)

sum = sum + 1
dump(sum)

sum = sum + 2
dump(sum)

sum = sum + 3
dump(sum)

// Results:
// 10
// 0
// 1
// 2
// 3
// 100
// 150
// 3.14
// 3.14159
// 0
// 1
// 3
// 6
