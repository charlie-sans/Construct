extern fn InitWindow(width: Int, height: Int, windowname: String) {}
extern fn WindowShouldClose() -> Bool {}
extern fn BeginDrawing() {}
extern fn EndDrawing() {}
extern fn ClearBackground(color: Int) {}
extern fn DrawText(text: String, posX: Int, posY: Int, fontSize: Int, color: Int) {}
extern fn CloseWindow() {}
extern fn meow() {}

let show = fn() ->
    InitWindow(800, 600, "My Raylib Window")
    meow()
    while !WindowShouldClose() do
        BeginDrawing()
        DrawText("Hello, Raylib!", 190, 200, 20, 0)
        EndDrawing()
    end
    CloseWindow()
